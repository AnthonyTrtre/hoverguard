<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Company>Utahpik</Company>
    <Product>Hoverguard</Product>
    <Copyright>© 2026 Utahpik</Copyright>
    <Authors>Utahpik</Authors>
    <!-- Permet de compiler le projet WPF depuis Linux ou macOS (sans l'exécuter). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
